{
  "configVersion": 2,
  "$comment": "Reference config. Easiest path: run `node bridge.mjs init <dir>`, which writes this file with a probed codex.exePath. See README.",
  "project": {
    "name": "demo",
    "workspace": "."
  },
  "codex": {
    "transport": "auto",
    "exePath": null,
    "model": null,
    "reasoningEffort": null,
    "sandbox": "workspace-write",
    "extraArgs": [],
    "workdir": ".codex-scratch",
    "apiKeyEnv": "OPENAI_API_KEY",
    "apiModel": "gpt-5.1-codex"
  },
  "budgets": {
    "_comment": "Token spend is NOT a working limit here. The two daily counters below are set far above any real run: they exist only as a runaway circuit-breaker (a crash loop, a bad prompt), not to ration normal work. The limits that actually shape a run are maxRounds, maxReviseAttempts and maxRunDurationMs.",
    "maxRounds": 40,
    "maxCodexCallsPerTask": 6,
    "maxReviseAttempts": 2,
    "maxRepairAttempts": 1,
    "maxTurnsTotal": 200,
    "maxRequestsPerDay": 10000,
    "maxTokensPerDay": 100000000,
    "maxTokensPerCall": 120000
  },
  "timeouts": {
    "codexCallMs": 900000,
    "codexStartupMs": 120000,
    "killGraceMs": 5000,
    "lockTtlMs": 960000,
    "lockWaitMs": 60000,
    "maxRunDurationMs": 21600000
  },
  "compact": {
    "auto": true,
    "maxThreadTokens": 500000
  },
  "summary": {
    "oneLineMaxChars": 400,
    "rollingMaxChars": 12288,
    "cardsKept": 12,
    "compactOnOverflow": true,
    "entryMaxChars": 300,
    "maxChangedEntries": 10,
    "maxFindingsEntries": 5,
    "maxBlockersEntries": 5,
    "nextHintMaxChars": 300
  },
  "retry": {
    "backoffMs": 2000,
    "maxTransportRetries": 2
  },
  "maxExecutorRuns": 25,
  "unattended": {
    "enabledByDefault": false,
    "askPermissionBeforeExternalActions": true
  },
  "queueMirror": {
    "enabled": false,
    "thread": null,
    "timeoutMs": 30000
  },
  "maxHumanResumes": 5
}
