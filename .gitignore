# Runtime state — regenerated by `node bridge.mjs run init`; never source.
state/
.codex-scratch/

# Generated per-task briefs.
seeds/task-*.txt

# install-bridge records the hashes it installed here, so the NEXT install can tell a
# local edit from a stale copy. It is machine state, not source.
.codex-bridge-manifest.json

# Backups install-bridge makes when a project file was modified locally.
*.bak-*

# Scratch commit-message files. `git commit -F <file>` avoids shell quoting of
# multi-line messages, which makes it very easy to leave the file tracked. Match both
# `something.commitmsg` and `.commitmsg-anything` -- the first pattern missed the
# second and the file got committed twice.
*.commitmsg
.commitmsg*
.msg.txt
.git-commit-msg.txt

# The example's runtime state (its seeds/ and work/ are tracked on purpose).
examples/*/state/
examples/*/.codex-scratch/

# OS noise
.DS_Store
Thumbs.db
desktop.ini
